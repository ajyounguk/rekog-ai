<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rekog AI</title>
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="icon" href="/assets/favicon.ico">
</head>

<body>
    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main">
            <% if (!result) { %>
                <section class="card empty">
                    <h1>Analyse an image</h1>
                    <p>Upload a PNG or JPEG, or pick one of the samples in the sidebar. Rekog AI sends it to
                        Amazon Rekognition and shows the labels, text and faces it finds.</p>
                </section>
            <% } else { %>
                <%- include('partials/summary') %>
                <% if (result.error) { %>
                    <section class="card error-card" id="error">
                        <h2><%= result.error.name %></h2>
                        <p><%= result.error.message %></p>
                    </section>
                <% } else { %>
                    <%- include('partials/results') %>
                <% } %>
                <%- include('partials/response') %>
            <% } %>
        </main>
    </div>
    <script src="/assets/app.js"></script>
</body>

</html>
